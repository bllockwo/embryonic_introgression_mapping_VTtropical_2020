sds=seq(from=1, to = 10, by = 1)
sim.power =
foreach(l=1:length(mediff),.combine = "rbind")%do%{
foreach(j=1:length(sds),.combine = "rbind")%do%{
foreach(k=1:length(n),.combine = "rbind")%do%{
foreach(i=1:100,.combine = "rbind")%do%{
rnorm(n=n[k] , mean=1+mediff[l], sd=j) -> lower
rnorm(n=n[k] , mean=1-mediff[l], sd=j) -> upper
t.test(lower, upper) -> tmp.out
data.frame(
SD = j,
delta = abs((1+l) - (1-l)),
N=n[k],
rep=i,
p=tmp.out$p.value
)
}}}}
